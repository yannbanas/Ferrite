/target
# cargo-fuzz builds in its own workspace and stores corpora next to it.
crates/*/fuzz/target
crates/*/fuzz/corpus
crates/*/fuzz/artifacts
crates/*/fuzz/coverage
.claude/

# The server default data directory (FERRITE_DATA), if it is ever run
# from inside the repository.
data/

# Default output of tools/sqlite_to_ferrite.py: a translated copy of
# somebody's real database, which has no business in the repository.
out/
